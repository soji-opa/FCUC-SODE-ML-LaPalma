{
  "totalCost": "totalCost..obj=e=sum((t,i),a(i)*x(t,i))+sum((t,i,b),k(i,b)*g_lin(t,i,b))+sum((t,i,j),suc_sw(i,j)*suc(t,i,j))+ws_penalty*sum(t,curt(t));",
  "statusFirst": "statusFirst(i)..x('t1',i)-onoff_t0(i)=e=y('t1',i)-z('t1',i);",
  "statusLater": "statusLater(t,i)$(ord(t)>1)..x(t,i)-x(t-1,i)=e=y(t,i)-z(t,i);",
  "exclusiveSwitch": "exclusiveSwitch(t,i)..y(t,i)+z(t,i)=l=1;",
  "sumBlocks": "sumBlocks(t,i)..g(t,i)=e=sum(b,g_lin(t,i,b));",
  "minimumGeneration": "minimumGeneration(t,i)..g(t,i)=g=g_min(i)*x(t,i);",
  "blockLimits": "blockLimits(t,i,b)..g_lin(t,i,b)=l=g_max(i,b)*x(t,i);",
  "minimumUpTime": "minimumUpTime(t,i)..sum(tt$(ord(tt)<=ord(t)andord(tt)>ord(t)-g_up(i)),y(tt,i))=l=x(t,i);",
  "minimumDownTime": "minimumDownTime(t,i)..sum(tt$(ord(tt)<=ord(t)andord(tt)>ord(t)-g_down(i)),z(tt,i))=l=1-x(t,i);",
  "rampUpFirst": "rampUpFirst(i)..g('t1',i)-g_0(i)=l=ramp_up(i);",
  "rampDownFirst": "rampDownFirst(i)..g_0(i)-g('t1',i)=l=ramp_down(i);",
  "rampUpLater": "rampUpLater(t,i)$(ord(t)>1)..g(t,i)-g(t-1,i)=l=ramp_up(i);",
  "rampDownLater": "rampDownLater(t,i)$(ord(t)>1)..g(t-1,i)-g(t,i)=l=ramp_down(i);",
  "onAgeCap": "onAgeCap(t,i)..onAge(t,i)=l=ageM*x(t,i);",
  "offAgeCap": "offAgeCap(t,i)..offAge(t,i)=l=ageM*(1-x(t,i));",
  "onFirstLower": "onFirstLower(i)..onAge('t1',i)=g=count_on_init(i)+1-ageM*(1-x('t1',i));",
  "onFirstUpper": "onFirstUpper(i)..onAge('t1',i)=l=count_on_init(i)+1+ageM*(1-x('t1',i));",
  "offFirstLower": "offFirstLower(i)..offAge('t1',i)=g=count_off_init(i)+1-ageM*x('t1',i);",
  "offFirstUpper": "offFirstUpper(i)..offAge('t1',i)=l=count_off_init(i)+1+ageM*x('t1',i);",
  "onLaterLower": "onLaterLower(t,i)$(ord(t)>1)..onAge(t,i)=g=onAge(t-1,i)+1-ageM*(1-x(t,i));",
  "onLaterUpper": "onLaterUpper(t,i)$(ord(t)>1)..onAge(t,i)=l=onAge(t-1,i)+1+ageM*(1-x(t,i));",
  "offLaterLower": "offLaterLower(t,i)$(ord(t)>1)..offAge(t,i)=g=offAge(t-1,i)+1-ageM*x(t,i);",
  "offLaterUpper": "offLaterUpper(t,i)$(ord(t)>1)..offAge(t,i)=l=offAge(t-1,i)+1+ageM*x(t,i);",
  "startCategorySum": "startCategorySum(t,i)..sum(j,suc(t,i,j))=e=y(t,i);",
  "startFirstLower": "startFirstLower(i,j)..count_off_init(i)=g=suc_sl(i,j)-ageM*(1-suc('t1',i,j));",
  "startFirstUpper": "startFirstUpper(i,j)..count_off_init(i)=l=startupUpper(i,j)+ageM*(1-suc('t1',i,j));",
  "startLaterLower": "startLaterLower(t,i,j)$(ord(t)>1)..offAge(t-1,i)=g=suc_sl(i,j)-ageM*(1-suc(t,i,j));",
  "startLaterUpper": "startLaterUpper(t,i,j)$(ord(t)>1)..offAge(t-1,i)=l=startupUpper(i,j)+ageM*(1-suc(t,i,j));",
  "powerBalance": "powerBalance(t)..sum(i,g(t,i))+RES_det(t)-curt(t)=e=d(t);",
  "Hdef": "Hdef(t,i)..Hafter(t,i)=e=sum(ii$(notsameas(ii,i)),inertia(ii)*mbase(ii)*x(t,ii));",
  "Gdef": "Gdef(t,i)..Gafter(t,i)=e=sum(ii$(notsameas(ii,i)),kg(ii)*mbase(ii)*x(t,ii)/50);",
  "Rdef": "Rdef(t,i)..Rafter(t,i)=e=sum(ii$(notsameas(ii,i)),g_max_flat(ii)*x(t,ii)-g(t,ii));",
  "rocof": "rocof(t,i)$(runMode>0)..2*Hafter(t,i)*2.5/50=g=g(t,i);",
  "qss": "qss(t,i)$(runMode>0)..Rafter(t,i)=g=g(t,i);",
  "mlSecurity": "mlSecurity(t,i)$useML..sum(activeRun,lpK0(activeRun)+lpKE(activeRun)*Hafter(t,i)+lpKG(activeRun)*Gafter(t,i)+lpKL(activeRun)*g(t,i)+lpKR(activeRun)*Rafter(t,i)+lpBigM(activeRun,i)*(1-x(t,i)))=g=0;"
}
